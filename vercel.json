{
  "framework": "vite",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/refresh-egs",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/refresh-narrative",
      "schedule": "0 10-22 * * *"
    },
    {
      "path": "/api/cron/refresh-layoffs",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-global-yields",
      "schedule": "30 21 * * 1-5"
    },
    {
      "path": "/api/cron/refresh-central-banks",
      "schedule": "0 12 1 * *"
    }
  ]
}
